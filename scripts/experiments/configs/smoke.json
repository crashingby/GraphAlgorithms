{
  "name": "fault_tolerance_overhead_smoke",
  "datasets": ["cit-HepPh"],
  "algorithms": ["bfs", "cc", "kcore", "pagerank"],
  "methods": ["basic", "tolerance_queue", "multigpu_basic", "multigpu"],
  "repeat": 1,
  "warmup": 1,
  "timeout_s": 600,
  "mpi_ranks": 2,
  "parameters": {
    "k": 5,
    "alpha": 0.5,
    "beta": 0.5,
    "threshold": 0.3
  },
  "launcher": {
    "command": "mpirun",
    "ranks_flag": "-np",
    "extra_args": ["--bind-to", "none"]
  }
}
